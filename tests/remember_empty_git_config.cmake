# CTest's Windows environment restore drops NAME= between tests. Remember only
# the indices of Git settings that were present and empty when CTest started.
unset(ENV{TERMOLE_TEST_EMPTY_GIT_INDICES})
set(git_count "$ENV{GIT_CONFIG_COUNT}")
if(NOT git_count MATCHES "^[0-9]+$" OR git_count GREATER 2147483647)
  return()
endif()
set(git_empty_indices "")
set(git_index 0)
while(git_index LESS git_count)
  if(NOT DEFINED ENV{GIT_CONFIG_KEY_${git_index}} OR NOT DEFINED ENV{GIT_CONFIG_VALUE_${git_index}})
    return()
  endif()
  if("$ENV{GIT_CONFIG_VALUE_${git_index}}" STREQUAL "")
    string(APPEND git_empty_indices " ${git_index}")
  endif()
  math(EXPR git_index "${git_index} + 1")
endwhile()
set(ENV{TERMOLE_TEST_EMPTY_GIT_INDICES} "${git_empty_indices}")
